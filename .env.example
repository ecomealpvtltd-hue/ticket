# Copy to Netlify → Site configuration → Environment variables (never commit real values).
# Generate the two secrets with:  npm run keys

# Required
PUBLIC_BASE_URL=https://support.ecomeal.in
SESSION_SECRET=
ENCRYPTION_KEY=
BOOTSTRAP_OWNER_EMAILS=you@ecomeal.in

# Database: leave empty if Netlify Database is enabled on the site (it provides NETLIFY_DB_URL).
# Otherwise paste a Postgres connection string (e.g. from Neon), ending in ?sslmode=require
DATABASE_URL=

# Google: admin sign-in + Drive/Sheets sync (see README → Google setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI triage (category, priority suggestion, summary)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# Optional: environment name. Defaults to production. Use "staging" for a staging site.
APP_ENV=production
